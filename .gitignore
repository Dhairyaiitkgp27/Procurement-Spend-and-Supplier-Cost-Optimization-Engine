# ---- Generated data & artifacts ----
# These are fully reproducible with `make all` (or `python -m src.pipeline`).
# The committed markdown docs already contain the headline numbers, and
# outputs/consolidated_kpis.json is kept so results are visible on GitHub.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
outputs/tables/*
!outputs/tables/.gitkeep
outputs/powerbi/*
!outputs/powerbi/.gitkeep

